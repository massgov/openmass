+    $data['no-update-access-transition-access'] = [
+      $moderation_info,
+      $node,
+      FALSE,
+      $account,
+      $validator,
+    ];
+
+    // Same workflow with update access, with valid transition and transition
+    // access.
+    $workflow = clone $instance->workflow;
+    $workflow->expects($instance->exactly(2))
+      ->method('id')
+      ->willReturn('foo');
