+
+    // Same workflow but no node update access.
+    $workflow = clone $instance->workflow;
+
+    $workflow->expects($instance->once())
+      ->method('id')
+      ->willReturn('foo');
+
+    $moderation_info = clone $instance->moderationInfo;
