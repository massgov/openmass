diff --git a/lib/Drupal/Core/Session/AccessPolicyProcessor.php b/lib/Drupal/Core/Session/AccessPolicyProcessor.php
--- a/lib/Drupal/Core/Session/AccessPolicyProcessor.php
+++ b/lib/Drupal/Core/Session/AccessPolicyProcessor.php
@@ -50,18 +50,25 @@
     // If running in a fiber and processing a different account, prevent the
     // account switch from escaping to outside the fiber by resuming the fiber
     // if it was suspended.
-    $fiber = new \Fiber([$this, 'doProcessAccessPolicies']);
-    $fiber->start($account, $scope);
-    while (!$fiber->isTerminated()) {
-      if ($fiber->isSuspended()) {
-        $resume_type = $fiber->resume();
-        if (!$fiber->isTerminated() && $resume_type !== FiberResumeType::Immediate) {
-          usleep(500);
+    try {
+      $fiber = new \Fiber([$this, 'doProcessAccessPolicies']);
+      $fiber->start($account, $scope);
+      while (!$fiber->isTerminated()) {
+        if ($fiber->isSuspended()) {
+          $resume_type = $fiber->resume();
+          if (!$fiber->isTerminated() && $resume_type !== FiberResumeType::Immediate) {
+            usleep(500);
+          }
         }
       }
+      return $fiber->getReturn();
     }
-
-    return $fiber->getReturn();
+    catch (\FiberError) {
+      // Nested Fiber::start() can fail in some execution contexts (for example
+      // nested rendering). Fall back to direct processing; doProcessAccessPolicies
+      // still switches accounts with try/finally to avoid leaking switched users.
+      return $this->doProcessAccessPolicies($account, $scope);
+    }
   }
 
