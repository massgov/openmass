+  /**
+   * Reads the values to keep in the action configuration off a field.
+   *
+   * An entity reference autocomplete hands back an unsaved entity for a value
+   * the editor typed instead of picked. The action configuration is serialised
+   * once, when the batch is created, so every batch request restores that same
+   * unsaved entity and tries to insert it again under the one UUID it carries,
+   * which the database refuses - leaving only the entities of the first batch
+   * request saved. Save the referenced entity here instead, so the whole batch
+   * shares the single entity the editor asked for.
+   *
+   * @param \Drupal\Core\Field\FieldItemListInterface $items
+   *   The field to read the values off.
+   *
+   * @return array
+   *   The field values to store.
+   */
+  protected function extractFieldValues(FieldItemListInterface $items): array {
+    $values = $items->getValue();
+
+    // Entity reference revisions and its kin want an own revision per edited
+    // entity, so leave everything but a plain reference alone.
+    if ($items->getFieldDefinition()->getType() !== 'entity_reference') {
+      return $values;
+    }
+
+    foreach ($items as $delta => $item) {
+      if ($item->hasNewEntity()) {
+        $item->entity->save();
+        $values[$delta]['target_id'] = $item->entity->id();
       }
+      // The referenced entity is on file now, and carrying the object along
+      // would only give it another chance to be saved.
+      unset($values[$delta]['entity']);
     }
+
+    return $values;
   }
 
