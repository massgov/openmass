new file mode 100644
index 000000000..9e627939e
--- /dev/null
+++ b/entity_usage_queue_tracking.install
@@ -0,0 +1,47 @@
+<?php
+
+/**
+ * @file
+ * Install, update, and uninstall functions.
+ */
+
+/**
+ * Removes legacy deletion items from the entity usage tracking queue.
+ */
+function entity_usage_queue_tracking_update_9001(): string {
+  $connection = \Drupal::database();
+  $delete_operations = [
+    'predelete',
+    'revision_delete',
+    'translation_delete',
+  ];
+  $deleted = 0;
+
+  // Check both database queue tables in case the queue backend changed after
+  // an item was created.
+  foreach (['queue', 'queue_unique'] as $table) {
+    if (!$connection->schema()->tableExists($table)) {
+      continue;
+    }
+
+    $item_ids = [];
+    $items = $connection->select($table, 'q')
+      ->fields('q', ['item_id', 'data'])
+      ->condition('name', 'entity_usage_tracker')
+      ->execute();
+    foreach ($items as $item) {
+      $data = unserialize($item->data, ['allowed_classes' => FALSE]);
+      if (is_array($data) && in_array($data['operation'] ?? '', $delete_operations, TRUE)) {
+        $item_ids[] = $item->item_id;
+      }
+    }
+
+    foreach (array_chunk($item_ids, 500) as $item_id_chunk) {
+      $deleted += $connection->delete($table)
+        ->condition('item_id', $item_id_chunk, 'IN')
+        ->execute();
+    }
+  }
+
+  return "Removed $deleted legacy entity usage deletion queue items.";
+}
