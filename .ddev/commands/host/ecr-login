#!/bin/bash
set -euo pipefail

## Description: Authenticate Docker with the private database image registry.
## Usage: ecr-login
## Example: "ddev ecr-login"

source .ddev/.env

: "${MASS_DB_AWS_ACCOUNT_ID:?Set MASS_DB_AWS_ACCOUNT_ID in .ddev/.env}"
: "${MASS_DB_AWS_REGION:?Set MASS_DB_AWS_REGION in .ddev/.env}"

registry="${MASS_DB_AWS_ACCOUNT_ID}.dkr.ecr.${MASS_DB_AWS_REGION}.amazonaws.com"

# CircleCI has no SSO profile. It assumes an AWS role before starting DDEV and
# leaves MASS_DB_AWS_PROFILE_NAME empty, so the default credentials are used.
if [ -z "${MASS_DB_AWS_PROFILE_NAME:-}" ]; then
  if [ -z "${CI:-}" ]; then
    echo "Set MASS_DB_AWS_PROFILE_NAME in .ddev/.env" >&2
    exit 1
  fi
  password="$(aws ecr get-login-password --region "${MASS_DB_AWS_REGION}")"
elif ! password="$(aws ecr get-login-password \
  --region "${MASS_DB_AWS_REGION}" \
  --profile "${MASS_DB_AWS_PROFILE_NAME}" 2>/dev/null)"; then
  echo "Your AWS SSO session has expired. Re-authenticating with profile '${MASS_DB_AWS_PROFILE_NAME}'..." >&2
  aws sso login --profile "${MASS_DB_AWS_PROFILE_NAME}"
  password="$(aws ecr get-login-password \
    --region "${MASS_DB_AWS_REGION}" \
    --profile "${MASS_DB_AWS_PROFILE_NAME}")"
fi

if ! printf '%s\n' "${password}" \
  | docker login --username AWS --password-stdin "${registry}"; then
  echo "Could not log Docker in to AWS ECR registry ${registry}." >&2
  exit 1
fi
