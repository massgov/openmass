<?php

/**
 * @file
 * Install/uninstall and update hooks related to the mass_media module.
 */

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_update_n().
 *
 * Change the field storage definition for the field_upload_file field to use
 * the private filesystem as the default upload destination.
 */
function mass_media_update_8001() {
  $old_config = FieldStorageConfig::loadByName('media', 'field_upload_file');
  $old_config
    ->setSetting('uri_scheme', 'private')
    ->save();
}

/**
 * Remove incomplete displays created by Able Player before its installer fix.
 */
function mass_media_update_10001() {
  $removed = 0;
  foreach (['core.entity_form_display.media.video.default', 'core.entity_view_display.media.video.default'] as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    if (!$config->isNew() && (!$config->get('targetEntityType') || !$config->get('bundle'))) {
      // Raw configuration deletion avoids instantiating the broken entity.
      $config->delete();
      $removed++;
    }
  }
  return t('Removed @count incomplete Able Player display records.', ['@count' => $removed]);
}
