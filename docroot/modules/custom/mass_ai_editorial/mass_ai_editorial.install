<?php

/**
 * @file
 * Install hooks for Mass AI Editorial.
 */

/**
 * Implements hook_schema().
 */
function mass_ai_editorial_schema(): array {
  $schema['mass_ai_editorial_document'] = [
    'description' => 'Canonical rendered document snapshots queued for AI editorial indexing.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'entity_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'revision_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'langcode' => [
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => 'en',
      ],
      'org_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'bundle' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'title' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => TRUE,
      ],
      'url' => [
        'type' => 'varchar',
        'length' => 2048,
        'not null' => FALSE,
      ],
      'view_mode' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'ai_index',
      ],
      'content_hash' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'rendered_text' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'queued',
      ],
      'queued_at' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'indexed_at' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'changed_at' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'error' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'entity_lang_view' => ['entity_type', 'entity_id', 'langcode', 'view_mode'],
    ],
    'indexes' => [
      'status_queued' => ['status', 'queued_at'],
      'org_status' => ['org_id', 'status'],
      'hash' => ['content_hash'],
    ],
  ];

  $schema['mass_ai_editorial_chunk'] = [
    'description' => 'Chunked rendered document text prepared for embedding generation.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'document_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'chunk_delta' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'chunk_hash' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'heading' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => FALSE,
      ],
      'text' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'token_estimate' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'embedding_model' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'embedding_ref' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'created_at' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'document_delta' => ['document_id', 'chunk_delta'],
    ],
    'indexes' => [
      'document_hash' => ['document_id', 'chunk_hash'],
      'embedding_model' => ['embedding_model'],
    ],
    'foreign keys' => [
      'document' => [
        'table' => 'mass_ai_editorial_document',
        'columns' => ['document_id' => 'id'],
      ],
    ],
  ];

  return $schema;
}

