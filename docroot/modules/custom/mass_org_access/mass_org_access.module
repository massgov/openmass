<?php

declare(strict_types=1);

use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_query_alter().
 */
function mass_org_access_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if (!$query instanceof Sql) {
    return;
  }

  $revision_table_map = [
    'rpt_permission_group_audit_nodes' => [
      'base_table' => 'node_field_revision',
      'permission_table' => 'node_revision__field_content_organization',
    ],
    'rpt_permission_group_audit_documents' => [
      'base_table' => 'media_field_revision',
      'permission_table' => 'media_revision__field_content_organization',
    ],
  ];

  $view_config = $revision_table_map[$view->id()] ?? NULL;
  if ($view_config === NULL) {
    return;
  }

  $connection = $query->getConnection();
  $revision_alias = $query->ensureTable($view_config['base_table']);

  // Show only rows where the author and revision share no Permission
  // Group terms at all.
  $shared_permission_group = $connection->select('user__field_user_org', 'uo');
  $shared_permission_group->addExpression('1');
  $shared_permission_group->innerJoin(
    $view_config['permission_table'],
    'nco',
    'nco.field_content_organization_target_id = uo.field_user_org_target_id'
  );
  $shared_permission_group->condition('uo.deleted', 0);
  $shared_permission_group->condition('nco.deleted', 0);
  $shared_permission_group->where("uo.entity_id = {$revision_alias}.uid");
  $shared_permission_group->where("nco.revision_id = {$revision_alias}.vid");
  $shared_permission_group->where("nco.langcode = {$revision_alias}.langcode");

  $query->addWhere(0, $connection->condition('AND')->notExists($shared_permission_group));
}
